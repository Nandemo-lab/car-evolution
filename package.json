{
  "name": "car-evolution",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "npm run quality:gate",
    "quality:gate": "node --test tests/*.test.js && node scripts/audit-content-value.mjs && node scripts/audit-full-site.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "audit:content": "node scripts/audit-content-value.mjs",
    "audit:sources": "node scripts/audit-official-sources.mjs",
    "audit:site": "node scripts/audit-full-site.mjs",
    "audit:site:live": "node scripts/audit-full-site.mjs --live",
    "audit:browser": "node scripts/audit-browser.mjs"
  },
  "devDependencies": {
    "vite": "^7.1.7"
  }
}
