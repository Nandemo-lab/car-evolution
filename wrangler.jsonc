{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carvista-static",
  "compatibility_date": "2026-11-04",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "https://carvista.jp/*",
      "zone_name": "carvista.jp"
    }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "none",
    "not_found_handling": "404-page"
  }
}
